# Coinbase Advanced Trade API credentials
# Get these from https://www.coinbase.com/settings/api
# Use "Advanced Trade" API key type (not legacy)

COINBASE_API_KEY=your_api_key_name_here
COINBASE_API_SECRET=your_ec_private_key_here

# Trading configuration
# Comma-separated list of trading pairs to monitor
TRADING_PAIRS=BTC-USD,ETH-USD,SOL-USD

# Risk per trade as a fraction of portfolio (0.02 = 2%)
RISK_PER_TRADE=0.02

# Maximum number of simultaneous open positions
MAX_OPEN_POSITIONS=3

# Minimum model confidence threshold to enter a trade (0.0-1.0)
MIN_CONFIDENCE=0.62

# Paper trading mode (true = no real orders placed)
PAPER_TRADING=true

# Retrain model every N hours (0 = no automatic retraining)
RETRAIN_INTERVAL_HOURS=24

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
